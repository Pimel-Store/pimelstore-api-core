{
  "version": 2,
  "builds": [
    { "src": "api/auth/*.ts", "use": "@vercel/node" },
    { "src": "api/register/*.ts", "use": "@vercel/node" },
    { "src": "api/sales/*.ts", "use": "@vercel/node" },
    { "src": "api/expenses/*.ts", "use": "@vercel/node" },
    { "src": "api/viewers/*.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/register", "dest": "api/register/register.ts", "methods": ["POST", "OPTIONS"]},
    { "src": "/login", "dest": "api/auth/login.ts", "methods": ["POST", "OPTIONS"]},
    { "src": "/token", "dest": "api/auth/token.ts", "methods": ["GET", "OPTIONS"]},
    { "src": "/sales", "dest": "api/sales/sales.ts", "methods": ["POST", "GET", "PUT", "DELETE", "OPTIONS"]},
    { "src": "/sales/(?<id>[^/]+)", "dest": "api/sales/sales.ts", "methods": ["GET", "PUT", "DELETE", "OPTIONS"]},
    { "src": "/expenses", "dest": "api/expenses/expenses.ts", "methods": ["POST", "GET", "PUT", "DELETE", "OPTIONS"]},
    { "src": "/expenses/(?<id>[^/]+)", "dest": "api/expenses/expenses.ts", "methods": ["GET", "PUT", "DELETE", "OPTIONS"]},
    { "src": "/dashboard", "dest": "api/viewers/dashboard.ts", "methods": ["GET", "OPTIONS"]}
  ]
}
